#!/bin/bash -l
# The submission script holds this job until the full array leaves the queue.
#$ -cwd
#$ -N cindes_btab
#$ -j y
#$ -pe omp 2
#$ -l h_rt=01:00:00
set -eo pipefail
: "${SGE_O_WORKDIR:?Submit from the package directory.}"
cd "$SGE_O_WORKDIR"
output_root="${1:?The submission script must supply the output directory.}"
environment_script="${2:--}"
python_bin="${3:-python3}"
export CINDES_CPU_THREADS="${NSLOTS:-2}"
if [[ "$environment_script" == - ]]; then unset CINDES_ENV_SCRIPT; else export CINDES_ENV_SCRIPT="$environment_script"; fi
source ./scc_env.sh
# These commands require all 80 valid pairs; an incomplete run cannot produce
# an apparently complete table or return ZIP through this automatic job.
"$python_bin" summarize_results.py --profile full --root "$output_root"
"$python_bin" make_results_bundle.py --profile full --root "$output_root"
